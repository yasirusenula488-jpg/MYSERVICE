        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["providerId", "planId", "planName", "billingCycle", "amountLkr", "status", "paymentMode", "createdAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
