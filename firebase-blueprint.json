      "required": ["bookingId", "providerId", "customerId", "grossAmountLkr", "commissionRatePct", "commissionAmountLkr", "netProviderLkr", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification for user events.",
