{
  "entities": {
    "User": {
      "title": "User",
      "description": "Core user account supporting unified Customer and Provider modes.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "preferredLanguage": { "type": "string", "enum": ["en", "si", "ta"] },
        "province": { "type": "string", "maxLength": 60 },
        "district": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "maxLength": 80 },
        "providerStatus": { "type": "string", "enum": ["not_submitted", "pending_review", "verified", "rejected", "suspended"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "preferredLanguage", "providerStatus", "accountStatus", "createdAt", "updatedAt"]
    },
    "UserPrivateContact": {
      "title": "UserPrivateContact",
      "description": "Private PII contact fields isolated from public user documents.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 30 },
        "privateAddress": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized administrator registry record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 160 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "ProviderProfile": {
      "title": "ProviderProfile",
      "description": "Public service provider profile excluding private identity documents.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "businessName": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "province": { "type": "string", "minLength": 2, "maxLength": 60 },
        "district": { "type": "string", "minLength": 2, "maxLength": 60 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "categoryIds": { "type": "array" },
        "subcategories": { "type": "array" },
        "coverageDistricts": { "type": "array" },
        "yearsExperience": { "type": "number" },
        "bio": { "type": "string", "minLength": 10, "maxLength": 1500 },
        "qualifications": { "type": "string", "maxLength": 600 },
        "startingPriceLkr": { "type": "number" },
        "workingDays": { "type": "array" },
        "timeSlots": { "type": "string", "maxLength": 160 },
        "portfolioUrls": { "type": "array" },
        "photoThumbnails": { "type": "array", "maxItems": 3 },
        "photoCaptions": { "type": "array", "maxItems": 3 },
        "verificationStatus": { "type": "string", "enum": ["not_submitted", "pending_review", "verified", "rejected", "suspended"] },
        "rejectionReason": { "type": "string", "maxLength": 400 },
        "ratingAvg": { "type": "number" },
        "reviewCount": { "type": "number" },
        "subscriptionPlanId": { "type": "string", "maxLength": 64 },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullName", "province", "district", "city", "categoryIds", "coverageDistricts", "yearsExperience", "bio", "startingPriceLkr", "verificationStatus", "createdAt", "updatedAt"]
    },
    "ProviderVerification": {
      "title": "ProviderVerification",
      "description": "Private verification documents and admin review history.",
      "type": "object",
      "properties": {
        "providerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 30 },
        "nicOrRegNumber": { "type": "string", "maxLength": 60 },
        "certificateSummary": { "type": "string", "maxLength": 500 },
        "documentNames": { "type": "array" },
        "status": { "type": "string", "enum": ["pending_review", "verified", "rejected", "suspended"] },
        "reviewNotes": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "submittedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["providerId", "email", "phone", "nicOrRegNumber", "status", "submittedAt", "updatedAt"]
    },
    "ServiceCategory": {
      "title": "ServiceCategory",
      "description": "Admin-managed marketplace service category with trilingual labels.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name_en": { "type": "string", "minLength": 2, "maxLength": 80 },
        "name_si": { "type": "string", "minLength": 2, "maxLength": 120 },
        "name_ta": { "type": "string", "minLength": 2, "maxLength": 120 },
        "description_en": { "type": "string", "maxLength": 300 },
        "description_si": { "type": "string", "maxLength": 400 },
        "description_ta": { "type": "string", "maxLength": 400 },
        "iconName": { "type": "string", "maxLength": 40 },
        "imageUrl": { "type": "string", "maxLength": 300 },
        "subcategories": { "type": "array" },
        "sortOrder": { "type": "number" },
        "requiresSpecialistVerification": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "slug", "name_en", "name_si", "name_ta", "subcategories", "sortOrder", "isActive", "updatedAt"]
    },
    "ServiceListing": {
      "title": "ServiceListing",
      "description": "Published service offered by a provider.",
      "type": "object",
      "properties": {
        "providerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "providerVerified": { "type": "boolean" },
        "title": { "type": "string", "minLength": 4, "maxLength": 120 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "subcategory": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "minLength": 10, "maxLength": 1500 },
        "province": { "type": "string", "maxLength": 60 },
        "district": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "maxLength": 80 },
        "coverageDistricts": { "type": "array" },
        "priceLkr": { "type": "number" },
        "priceUnit": { "type": "string", "maxLength": 40 },
        "imageUrl": { "type": "string", "maxLength": 300 },
        "ratingAvg": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isSample": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["providerId", "providerName", "title", "categoryId", "subcategory", "description", "province", "district", "city", "coverageDistricts", "priceLkr", "isActive", "createdAt", "updatedAt"]
    },
    "JobRequest": {
      "title": "JobRequest",
      "description": "Customer service job request open for provider quotations.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 4, "maxLength": 140 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "subcategory": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "province": { "type": "string", "maxLength": 60 },
        "district": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "maxLength": 80 },
        "preferredDate": { "type": "string", "maxLength": 30 },
        "preferredTime": { "type": "string", "maxLength": 40 },
        "budgetMinLkr": { "type": "number" },
        "budgetMaxLkr": { "type": "number" },
        "instructions": { "type": "string", "maxLength": 600 },
        "photoThumbnails": { "type": "array", "maxItems": 3 },
        "photoCaptions": { "type": "array", "maxItems": 3 },
        "status": { "type": "string", "enum": ["open", "quoted", "assigned", "completed", "cancelled", "closed"] },
        "assignedProviderId": { "type": "string", "maxLength": 128 },
        "quotationCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "customerName", "title", "categoryId", "subcategory", "description", "province", "district", "city", "preferredDate", "status", "createdAt", "updatedAt"]
    },
    "JobPrivateAddress": {
      "title": "JobPrivateAddress",
      "description": "Private exact service address revealed only to customer, assigned provider, and admin.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "exactAddress": { "type": "string", "maxLength": 300 },
        "contactPhone": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "customerId", "exactAddress", "updatedAt"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Provider quotation submitted for a customer job request.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "jobTitle": { "type": "string", "maxLength": 140 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerName": { "type": "string", "maxLength": 100 },
        "providerVerified": { "type": "boolean" },
        "amountLkr": { "type": "number" },
        "estimatedDuration": { "type": "string", "maxLength": 80 },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "withdrawn"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "jobTitle", "customerId", "providerId", "providerName", "amountLkr", "estimatedDuration", "status", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Confirmed service booking between customer and provider.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string", "maxLength": 128 },
        "quotationId": { "type": "string", "maxLength": 128 },
        "listingId": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "maxLength": 100 },
        "providerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerName": { "type": "string", "maxLength": 100 },
        "serviceTitle": { "type": "string", "maxLength": 140 },
        "district": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "maxLength": 80 },
        "scheduledDate": { "type": "string", "maxLength": 30 },
        "scheduledTime": { "type": "string", "maxLength": 40 },
        "amountLkr": { "type": "number" },
        "commissionRatePct": { "type": "number" },
        "commissionLkr": { "type": "number" },
        "status": { "type": "string", "enum": ["pending_confirmation", "confirmed", "in_progress", "completed", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "demo_paid", "paid", "refunded"] },
        "reviewSubmitted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "customerName", "providerId", "providerName", "serviceTitle", "district", "city", "scheduledDate", "amountLkr", "status", "paymentStatus", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Private 1:1 messaging thread between customer and provider.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "maxLength": 100 },
        "providerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerName": { "type": "string", "maxLength": 100 },
        "contextTitle": { "type": "string", "maxLength": 140 },
        "lastMessage": { "type": "string", "maxLength": 300 },
        "lastSenderId": { "type": "string", "maxLength": 128 },
        "unreadByCustomer": { "type": "boolean" },
        "unreadByProvider": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "customerName", "providerId", "providerName", "contextTitle", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message inside a private conversation.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "maxLength": 100 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "senderId", "senderName", "text", "isRead", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer review tied to a completed booking.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "maxLength": 100 },
        "providerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 4, "maxLength": 1000 },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "customerId", "customerName", "providerId", "rating", "comment", "isPublished", "createdAt"]
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "description": "Admin-configurable provider subscription tier.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
