        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "monthlyPriceLkr", "yearlyPriceLkr", "listingLimit", "durationDays", "features", "isActive", "updatedAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Active or past provider subscription record.",
      "type": "object",
      "properties": {
        "providerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planId": { "type": "string", "maxLength": 64 },
        "planName": { "type": "string", "maxLength": 60 },
        "billingCycle": { "type": "string", "enum": ["free", "monthly", "yearly"] },
        "amountLkr": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "expired", "cancelled", "pending_payment"] },
        "paymentMode": { "type": "string", "enum": ["free", "payhere_sandbox_demo", "payhere_live"] },
