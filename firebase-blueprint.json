        "refundStatus": { "type": "string", "enum": ["none", "requested", "refunded"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "paymentType", "referenceId", "amountLkr", "currency", "transactionRef", "gatewayMode", "status", "refundStatus", "createdAt"]
    },
