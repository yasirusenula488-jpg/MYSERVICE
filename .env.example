# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYHERE_MERCHANT_ID: Optional live/sandbox PayHere Merchant ID for production payments.
PAYHERE_MERCHANT_ID=

# PAYHERE_MERCHANT_SECRET: Optional PayHere Merchant Secret (server-side only).
PAYHERE_MERCHANT_SECRET=

# PAYHERE_SANDBOX: Set to "true" for PayHere Sandbox or "false" for live PayHere.
PAYHERE_SANDBOX=true
