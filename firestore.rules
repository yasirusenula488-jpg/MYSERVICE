          (
            existing().providerId == request.auth.uid
            && incoming().status == 'withdrawn'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(quotationId) && isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (existing().customerId == request.auth.uid || existing().providerId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && (existing().customerId == request.auth.uid || existing().providerId == request.auth.uid)) || isPrimaryAdmin();
      allow create: if isValidId(bookingId) && isVerifiedUser()
