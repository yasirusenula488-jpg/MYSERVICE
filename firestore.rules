          (
            existing().providerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'categoryId', 'subcategory', 'description', 'province', 'district', 'city', 'coverageDistricts', 'priceLkr', 'priceUnit', 'imageUrl', 'isActive', 'updatedAt'])
