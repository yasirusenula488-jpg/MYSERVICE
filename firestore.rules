      allow create, update: if isValidId(settingId) && isAdmin()
        && isValidAdminSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isPrimaryAdmin();
      allow create: if isValidId(logId) && isAdmin()
        && isValidAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /contactMessages/{messageId} {
      allow get, list: if isPrimaryAdmin();
      allow create: if isValidId(messageId)
        && isValidContactMessage(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if isValidId(messageId) && isAdmin();
    }
  }
}
