    match /quotations/{quotationId} {
      allow get: if isValidId(quotationId) && isSignedIn() && (existing().customerId == request.auth.uid || existing().providerId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && (existing().customerId == request.auth.uid || existing().providerId == request.auth.uid)) || isPrimaryAdmin();
