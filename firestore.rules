        && incoming().providerId == existing().providerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().status in ['pending_confirmation', 'confirmed', 'in_progress']
            && (
              (
                existing().providerId == request.auth.uid
                && incoming().status in ['confirmed', 'in_progress', 'completed', 'cancelled']
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              ) ||
              (
                existing().customerId == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt'])
              )
            )
          ) ||
          (
            existing().status == 'completed'
            && existing().customerId == request.auth.uid
            && incoming().status == 'completed'
            && incoming().reviewSubmitted == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['reviewSubmitted', 'updatedAt'])
          )
        );
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    match /conversations/{conversationId} {
