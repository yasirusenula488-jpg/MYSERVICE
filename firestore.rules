        && isValidJobRequest(incoming())
        && incoming().customerId == existing().customerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().customerId == request.auth.uid
            && existing().status in ['open', 'quoted', 'assigned']
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['title', 'categoryId', 'subcategory', 'description', 'province', 'district', 'city', 'preferredDate', 'preferredTime', 'budgetMinLkr', 'budgetMaxLkr', 'instructions', 'photoThumbnails', 'photoCaptions', 'status', 'assignedProviderId', 'updatedAt'])
            )
          ) ||
          (
            existing().status in ['open', 'quoted']
            && incoming().status == 'quoted'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'quotationCount', 'updatedAt'])
          )
        );
      allow delete: if isValidId(jobId) && isVerifiedUser() && (existing().customerId == request.auth.uid || isAdmin());

      match /private/{docId} {
        allow get: if isValidId(jobId) && isValidId(docId) && isSignedIn() && (
          existing().customerId == request.auth.uid ||
          get(/databases/$(database)/documents/jobRequests/$(jobId)).data.assignedProviderId == request.auth.uid ||
          isAdmin()
        );
        allow list: if false;
        allow create: if isValidId(jobId) && isValidId(docId) && isVerifiedUser()
          && isValidJobPrivateAddress(incoming())
          && incoming().jobId == jobId
          && incoming().customerId == request.auth.uid
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/jobRequests/$(jobId));
        allow update: if isValidId(jobId) && isValidId(docId) && isVerifiedUser()
          && isValidJobPrivateAddress(incoming())
          && incoming().jobId == existing().jobId
          && incoming().customerId == existing().customerId
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (existing().customerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['exactAddress', 'contactPhone', 'updatedAt']))
