          );
        allow update: if isValidId(conversationId) && isValidId(messageId) && isVerifiedUser()
          && isValidMessage(incoming())
          && incoming().senderId == existing().senderId
          && incoming().createdAt == existing().createdAt
          && (
            isAdmin() ||
            (
