    match /jobRequests/{jobId} {
      allow get: if isValidId(jobId) && (
        (isSignedIn() && (existing().status in ['open', 'quoted'] || existing().customerId == request.auth.uid || existing().assignedProviderId == request.auth.uid)) ||
        isAdmin()
      );
      allow list: if (isSignedIn() && (existing().status in ['open', 'quoted'] || existing().customerId == request.auth.uid || existing().assignedProviderId == request.auth.uid)) || isPrimaryAdmin();
      allow create: if isValidId(jobId) && isVerifiedUser()
